// © Pexilim
// Shared build settings. Personal values (Team ID, bundle prefix) go in Local.xcconfig, which is git-ignored.
BUNDLE_ID_PREFIX = com.example
APP_DISPLAY_NAME = Blink
DEVELOPMENT_TEAM =
#include? "Local.xcconfig"

PRODUCT_NAME = Blink
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).blink
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1

SDKROOT = auto
SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
TARGETED_DEVICE_FAMILY = 1
IPHONEOS_DEPLOYMENT_TARGET = 26.0
MACOSX_DEPLOYMENT_TARGET = 26.0

SWIFT_VERSION = 6.0
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES

CODE_SIGN_STYLE = Automatic
ENABLE_APP_SANDBOX = YES
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Config/Blink-macOS.entitlements
ENABLE_OUTGOING_NETWORK_CONNECTIONS = YES
// Export… for post images: only folders the owner picks in the save panel.
ENABLE_USER_SELECTED_FILES = readwrite
ENABLE_RESOURCE_ACCESS_CALENDARS = YES
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_PREVIEWS = YES

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_NSCalendarsFullAccessUsageDescription = Blink reads your calendars to show your next meeting in the notch.
INFOPLIST_KEY_NSRemindersFullAccessUsageDescription = Blink shows what's due today, and adds, completes, moves or deletes reminders when you ask it to.
INFOPLIST_KEY_NSFaceIDUsageDescription = Blink uses Face ID so only you can open it.
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
LD_RUNPATH_SEARCH_PATHS[sdk=macosx*] = $(inherited) @executable_path/../Frameworks
LD_RUNPATH_SEARCH_PATHS[sdk=iphone*] = $(inherited) @executable_path/Frameworks
