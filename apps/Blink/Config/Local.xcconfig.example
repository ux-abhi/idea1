// Copy to Local.xcconfig (git-ignored) and fill in. Nothing personal lives in source (ARCHITECTURE §36.9).
// Server address and keys are NOT here: the app asks for them on first run and keeps them in the Keychain.
DEVELOPMENT_TEAM = YOURTEAMID
BUNDLE_ID_PREFIX = com.pexilim
APP_DISPLAY_NAME = Blink
// The sign-in helper for one-click server setup (functions/signin on the distributor's server). Empty hides the button.
BLINK_SIGNIN_HELPER = https:/$()/YOUR-PROJECT.supabase.co/functions/v1/signin
