<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist. The sign-in helper's address comes from BLINK_SIGNIN_HELPER (Local.xcconfig). -->
	<key>BlinkSigninHelper</key>
	<string>$(BLINK_SIGNIN_HELPER)</string>
	<!-- One-click Google: Blink's Desktop-type Google client, from Local.xcconfig. Empty means "use your own Google app". -->
	<key>BlinkGoogleClientID</key>
	<string>$(BLINK_GOOGLE_CLIENT_ID)</string>
	<key>BlinkGoogleClientSecret</key>
	<string>$(BLINK_GOOGLE_CLIENT_SECRET)</string>
	<!-- Services menu (Mac): select text in any app, then Services › Add to Blink as Task / Save to Blink as Note. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict><key>default</key><string>Add to Blink as Task</string></dict>
			<key>NSMessage</key>
			<string>addTask</string>
			<key>NSPortName</key>
			<string>Blink</string>
			<key>NSSendTypes</key>
			<array><string>public.utf8-plain-text</string></array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict><key>default</key><string>Save to Blink as Note</string></dict>
			<key>NSMessage</key>
			<string>saveNote</string>
			<key>NSPortName</key>
			<string>Blink</string>
			<key>NSSendTypes</key>
			<array><string>public.utf8-plain-text</string></array>
		</dict>
	</array>
</dict>
</plist>
