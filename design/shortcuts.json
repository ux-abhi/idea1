{
  "_about": "Every keyboard shortcut in Blink, in one place. The app (BlinkKit Shortcuts.swift, checked against this file by a test) shows it in Settings and Help › Keyboard Shortcuts; blinkk.app/shortcuts shows a copy (marketing/site/lib/shortcuts.json, checked against this file by the site's tests).",
  "groups": [
    {
      "name": "Anywhere on your Mac",
      "items": [
        {
          "keys": "⌃⌥Space",
          "what": "Ask Blink in the notch"
        },
        {
          "keys": "⌃⌥V",
          "what": "Clipboard history"
        },
        {
          "keys": "⌃⌥K",
          "what": "Search everything, in the notch"
        }
      ]
    },
    {
      "name": "In the notch",
      "items": [
        {
          "keys": "Esc",
          "what": "Close the notch"
        },
        {
          "keys": "⌘⏎",
          "what": "Approve the top card (Create & Invite on a meeting card)"
        },
        {
          "keys": "/",
          "what": "Type / to see the notch commands (/task, /remind, /note, /timer, /spent, /meet…)"
        },
        {
          "keys": "Tab",
          "what": "Finish a /command"
        },
        {
          "keys": "↑ ↓",
          "what": "Move through search and clipboard results"
