{
  "$description": "Blink colour and material tokens (Pexilim). In SwiftUI never hardcode these hex values: map each token to the Apple semantic colour named in `swiftui` so Dark Mode, Increase Contrast and the user's accent colour adapt automatically. Hex values are Apple's published iOS values, for design files and the web only.",
  "apple": {
    "systemRed": {
      "light": "#FF3B30",
      "dark": "#FF453A"
    },
    "systemOrange": {
      "light": "#FF9500",
      "dark": "#FF9F0A"
    },
    "systemYellow": {
      "light": "#FFCC00",
      "dark": "#FFD60A"
    },
    "systemGreen": {
      "light": "#34C759",
      "dark": "#30D158"
    },
    "systemMint": {
      "light": "#00C7BE",
      "dark": "#63E6E2"
    },
    "systemTeal": {
      "light": "#30B0C7",
      "dark": "#40CBE0"
    },
    "systemCyan": {
      "light": "#32ADE6",
      "dark": "#64D2FF"
    },
    "systemBlue": {
      "light": "#007AFF",
      "dark": "#0A84FF"
    },
    "systemIndigo": {
      "light": "#5856D6",
      "dark": "#5E5CE6"
    },
    "systemPurple": {
      "light": "#AF52DE",
      "dark": "#BF5AF2"
    },
    "systemPink": {
      "light": "#FF2D55",
      "dark": "#FF375F"
    },
    "systemBrown": {
      "light": "#A2845E",
      "dark": "#AC8E68"
    },
    "systemGray": {
      "light": "#8E8E93",
      "dark": "#8E8E93"
    },
    "systemGray2": {
      "light": "#AEAEB2",
      "dark": "#636366"
    },
    "systemGray3": {
      "light": "#C7C7CC",
      "dark": "#48484A"
    },
    "systemGray4": {
      "light": "#D1D1D6",
      "dark": "#3A3A3C"
    },
    "systemGray5": {
      "light": "#E5E5EA",
      "dark": "#2C2C2E"
    },
    "systemGray6": {
      "light": "#F2F2F7",
      "dark": "#1C1C1E"
    }
  },
  "semantic": {
    "background": {
      "light": "#F2F2F7",
      "dark": "#000000",
      "swiftui": "Color(.systemGroupedBackground)"
    },
    "surface": {
      "light": "#FFFFFF",
      "dark": "#1C1C1E",
      "swiftui": "Color(.secondarySystemGroupedBackground)"
    },
    "surfaceRaised": {
      "light": "#FFFFFF",
      "dark": "#2C2C2E",
      "swiftui": "Color(.tertiarySystemGroupedBackground)"
    },
    "label": {
      "light": "#000000",
      "dark": "#FFFFFF",
      "swiftui": ".primary"
    },
    "labelSecondary": {
      "light": "rgba(60,60,67,0.60)",
      "dark": "rgba(235,235,245,0.60)",
      "swiftui": ".secondary"
    },
    "labelTertiary": {
      "light": "rgba(60,60,67,0.30)",
      "dark": "rgba(235,235,245,0.30)",
      "swiftui": ".tertiary"
    },
    "separator": {
      "light": "rgba(60,60,67,0.29)",
      "dark": "rgba(84,84,88,0.60)",
      "swiftui": "Color(.separator)"
    },
    "fill": {
      "light": "rgba(120,120,128,0.20)",
      "dark": "rgba(120,120,128,0.36)",
      "swiftui": "Color(.systemFill)"
    },
    "fillSecondary": {
      "light": "rgba(120,120,128,0.16)",
      "dark": "rgba(120,120,128,0.32)",
      "swiftui": "Color(.secondarySystemFill)"
    }
  },
  "blink": {
    "accent": {
      "maps": "systemBlue",
      "swiftui": "Color.accentColor",
      "note": "On macOS follows the user's chosen accent colour"
    },
    "mood.rest": {
      "value": "#FFFFFF",
      "note": "Eye colour at rest"
    },
    "mood.headsUp": {
      "maps": "systemMint",
      "note": "Time: meetings, reminders, countdowns"
    },
    "mood.important": {
      "maps": "systemRed",
      "note": "Needs you: important mail, limits"
    },
    "mood.thinking": {
      "maps": "systemIndigo",
      "note": "Claude is working"
    },
    "mood.done": {
      "maps": "systemGreen",
      "note": "Done, approved, on track"
    },
    "mood.attention": {
      "maps": "systemOrange",
      "note": "Concerned, evening, sleepy"
    },
    "money.food": {
      "maps": "systemPink"
    },
    "money.work": {
      "maps": "systemPurple"
    },
    "money.transport": {
      "maps": "systemCyan"
    },
    "money.home": {
      "maps": "systemBrown"
    },
    "notch.hardware": {
      "value": "#000000",
      "note": "Always pure black, both appearances"
    },
    "notch.tile": {
      "top": "#2C2C2E",
      "bottom": "#1C1C1E"
    },
    "mascot.shell": {
      "stops": [
        "#FFFFFF",
        "#F2F2F7",
        "#D1D1D6",
        "#AEAEB2"
      ],
      "note": "Porcelain: built from Apple's grays"
    },
    "mascot.patch": {
      "stops": [
        "#48484A",
        "#1C1C1E",
        "#000000"
      ],
      "note": "Ink glass"
    },
    "mood.celebrate": {
      "maps": "systemYellow",
      "note": "7 / 30 / 100-day streaks, publish, goal"
    },
    "mood.evening": {
      "maps": "systemOrange",
      "note": "21:30 planning, low intensity"
    },
    "mood.rule": "Every mood = colour + eye shape + word. Mood colours are fills or glyphs, never body text on light surfaces"
  },
  "glow": {
    "alpha": 0.55,
    "blurPt": 10,
    "rule": "Inside the notch or a live element only; never on static content"
  },
  "materials": {
    "liquidGlass.regular": {
      "swiftui": ".glassEffect(.regular)",
      "use": "Custom floating controls only (Blink button, quick-sheet bar). System toolbars, tab bars and sidebars adopt glass automatically: never add it again"
    },
    "liquidGlass.clear": {
      "swiftui": ".glassEffect(.clear)",
      "use": "Over photos and the mascot stage only"
    },
    "liquidGlass.tinted": {
      "swiftui": ".glassEffect(.regular.tint(.accentColor))",
      "use": "One primary floating control per screen"
    },
    "ultraThin": {
      "swiftui": ".ultraThinMaterial",
      "use": "Hover peeks over busy wallpapers"
    },
    "thin": {
      "swiftui": ".thinMaterial",
      "use": "Popovers. Not the notch or the no-notch pill: both are solid black"
    },
    "regular": {
      "swiftui": ".regularMaterial",
      "use": "Sheets (system). Ask-First cards sit on solid surface"
    },
    "thick": {
      "swiftui": ".thickMaterial",
      "use": "Text-heavy overlays"
    },
    "reduceTransparency": {
      "rule": "Every material falls back to `surface` automatically"
    }
  },
  "shape": {
    "corners": "continuous (squircle) everywhere",
    "radius": {
      "notchRest": 12,
      "notchOpen": 28,
      "card": 22,
      "tile": 18,
      "button": "capsule",
      "chip": "capsule"
    },
    "concentric": "innerRadius = outerRadius - padding",
    "hairline": "1 px at the display scale (0.5 pt on Retina)"
  },
  "elevation": {
    "light": {
      "card": [
        "0 1 2 rgba(0,0,0,0.06)",
        "0 8 24 rgba(0,0,0,0.08)"
      ]
    },
    "dark": {
      "card": "no shadow; use surfaceRaised + top specular edge rgba(255,255,255,0.10)"
    },
    "specularEdge": {
      "light": "inset 0 1 0 rgba(255,255,255,0.70)",
      "dark": "inset 0 1 0 rgba(255,255,255,0.10)"
    }
  },
  "type": {
    "ui": "SF Pro (system)",
    "numbers": "SF Pro Rounded, semibold, tabular figures",
    "code": "SF Mono"
  },
  "motion": {
    "$rule": "Springs for anything spatial; eased durations only for opacity, colour and blink. Retarget, never queue. Keyboard-initiated opens use the *Key variant. Reduce Motion uses `rm`.",
    "spring": {
      "peek": {
        "response": 0.35,
        "damping": 0.82,
        "durBounce": [
          0.35,
          0.18
        ],
        "use": "Rest↔Peek",
        "rm": "fade 0.2"
      },
      "open": {
        "response": 0.45,
        "damping": 0.78,
        "durBounce": [
          0.45,
          0.22
        ],
        "use": "Rest/Peek→Glance, Chat, Ask-First card shape",
        "rm": "snap shape + fade 0.2"
      },
      "openKey": {
        "response": 0.3,
        "damping": 0.88,
        "durBounce": [
          0.3,
          0.12
        ],
        "use": "⌥Space / ⌥G opens; content without stagger",
        "rm": "snap + fade 0.15"
      },
      "morph": {
        "response": 0.42,
        "damping": 0.85,
        "durBounce": [
          0.42,
          0.15
        ],
        "use": "Glance↔Chat↔Card inside the open panel; matched eyes and title",
        "rm": "snap + crossfade 0.2"
      },
      "close": {
        "response": 0.38,
        "damping": 0.9,
        "durBounce": [
          0.38,
          0.1
        ],
        "use": "Any→Rest (Esc, click-out, done)",
        "rm": "fade 0.15"
      },
      "focus": {
        "response": 0.5,
        "damping": 1.0,
        "durBounce": [
          0.5,
          0
        ],
        "use": "Rest↔Focus strip, Sleepy settle",
        "rm": "fade 0.25"
      },
      "content": {
        "response": 0.3,
        "damping": 0.9,
        "durBounce": [
          0.3,
          0.1
        ],
        "use": "Tiles and text enter: y+6pt→0 with opacity; rolling digits",
        "rm": "opacity 0.2"
      },
      "cardIn": {
        "response": 0.4,
        "damping": 0.82,
        "durBounce": [
          0.4,
          0.18
        ],
        "use": "Ask-First card grows from the eyes: scale 0.96→1, anchor top",
        "rm": "fade 0.2"
      },
      "cardApprove": {
        "response": 0.3,
        "damping": 1.0,
        "durBounce": [
          0.3,
          0
        ],
        "use": "Card out on ⌘⏎, collapses into the eyes",
        "rm": "fade 0.15"
      },
      "success": {
        "response": 0.4,
        "damping": 0.6,
        "durBounce": [
          0.4,
          0.4
        ],
        "use": "Done ∩∩ pop 0.9→1.0",
        "rm": "static ∩∩ + tint"
      },
      "eyeShape": {
        "response": 0.22,
        "damping": 0.9,
        "durBounce": [
          0.22,
          0.1
        ],
        "use": "Pill↔∩↔closed↔wide eye morph",
        "rm": "crossfade 0.15"
      },
      "press": {
        "response": 0.2,
        "damping": 0.7,
        "durBounce": [
          0.2,
          0.3
        ],
        "use": "Press scale 0.97",
        "rm": "opacity 0.9"
      },
      "dropZone": {
        "response": 0.25,
        "damping": 0.75,
        "durBounce": [
          0.25,
          0.25
        ],
        "use": "Drag enters the notch: 1.0→1.04",
        "rm": "tint only"
      },
      "interactive": {
        "response": 0.15,
        "damping": 0.86,
        "durBounce": [
          0.15,
          0.14
        ],
        "use": "Hold-to-talk, drag tracking",
        "rm": "same"
      }
    },
    "timing": {
      "blinkClose": {
        "dur": 0.09,
        "curve": "easeIn"
      },
      "blinkOpen": {
        "dur": 0.12,
        "curve": "easeOut"
      },
      "blinkInterval": {
        "min": 20,
        "max": 40,
        "doubleBlinkChance": 0.1,
        "use": "Idle only; none in Focus or calm"
      },
      "moodTint": {
        "dur": 0.25,
        "curve": "easeInOut"
      },
      "contentOut": {
        "dur": 0.12,
        "curve": "easeIn"
      },
      "crossfade": {
        "dur": 0.2,
        "curve": "easeInOut",
        "use": "Reduce Motion replacement for springs"
      },
      "ringTrim": {
        "dur": 0.6,
        "curve": "easeInOut",
        "use": "On data change only"
      },
      "importantPulse": {
        "dur": 0.6,
        "curve": "sine",
        "count": 1,
        "rm": "tint only"
      },
      "errorShake": {
        "dur": 0.36,
        "amplitudePt": 4,
        "oscillations": 3,
        "decay": true,
        "use": "Eyes only, never the notch shape",
        "rm": "tint + haptic"
      },
      "thinkingCycle": {
        "dur": 1.6,
        "curve": "sine",
        "slowAfter": 10,
        "slowDur": 3.2,
        "freezeAfter": 30,
        "use": "Then show 'Still working…'",
        "rm": "static pose + label"
      },
      "listening": {
        "smoothing": 0.1,
        "use": "Audio-level breathing, mic open only",
        "rm": "static wide eyes"
      },
      "morningOpen": {
        "dur": 0.8,
        "curve": "easeOut"
      },
      "sleepyClose": {
        "dur": 1.2,
        "curve": "easeInOut"
      },
      "celebrateBurst": {
        "dur": 0.8,
        "maxParticles": 30,
        "rm": "static gold ∩∩"
      }
    },
    "hold": {
      "done": 2.0,
      "undoChip": 6.0,
      "celebrate": 3.0,
      "minMoodDwell": 0.6,
      "skipThinkingUnder": 0.3,
      "eventCoalesce": 0.25
    },
    "choreography": {
      "contentDelay": 0.12,
      "stagger": 0.03,
      "staggerMax": 0.15,
      "staggerDirection": "leading→trailing",
      "closeContentLead": 0.06,
      "exitStagger": 0
    },
    "hover": {
      "intentIn": 0.15,
      "graceOut": 0.35
    },
    "fps": {
      "transition": "native, up to 120",
      "ambient": {
        "min": 15,
        "max": 30,
        "preferred": 30
      },
      "rest": 0,
      "calm": 0,
      "lowPowerOrThermalSerious": "ambient 0, springs only"
    },
    "haptics": {
      "ios": {
        "approve": ".success",
        "error": ".error",
        "destructiveConfirm": ".warning",
        "holdToTalkStart": ".impact(weight: .light)",
        "commandPick": ".selection",
        "moodChange": "none"
      },
      "mac": {
        "dropSnap": ".alignment",
        "holdToTalk": ".levelChange",
        "rule": "Force Touch trackpad, user-initiated only"
      }
    },
    "sound": {
      "default": "off",
      "p0": "system notification sound",
      "rule": "Never for mood changes; silent in Focus"
    }
  }
}