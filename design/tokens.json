{
  "$description": "Blink colour and material tokens (Pexilim). In SwiftUI never hardcode these hex values: map each token to the Apple semantic colour named in `swiftui` so Dark Mode, Increase Contrast and the user's accent colour adapt automatically. Hex values are Apple's published iOS values, for design files and the web only.",
  "apple": {
    "systemRed":    { "light": "#FF3B30", "dark": "#FF453A" },
    "systemOrange": { "light": "#FF9500", "dark": "#FF9F0A" },
    "systemYellow": { "light": "#FFCC00", "dark": "#FFD60A" },
    "systemGreen":  { "light": "#34C759", "dark": "#30D158" },
    "systemMint":   { "light": "#00C7BE", "dark": "#63E6E2" },
    "systemTeal":   { "light": "#30B0C7", "dark": "#40CBE0" },
    "systemCyan":   { "light": "#32ADE6", "dark": "#64D2FF" },
    "systemBlue":   { "light": "#007AFF", "dark": "#0A84FF" },
    "systemIndigo": { "light": "#5856D6", "dark": "#5E5CE6" },
    "systemPurple": { "light": "#AF52DE", "dark": "#BF5AF2" },
    "systemPink":   { "light": "#FF2D55", "dark": "#FF375F" },
    "systemBrown":  { "light": "#A2845E", "dark": "#AC8E68" },
    "systemGray":   { "light": "#8E8E93", "dark": "#8E8E93" },
    "systemGray2":  { "light": "#AEAEB2", "dark": "#636366" },
    "systemGray3":  { "light": "#C7C7CC", "dark": "#48484A" },
    "systemGray4":  { "light": "#D1D1D6", "dark": "#3A3A3C" },
    "systemGray5":  { "light": "#E5E5EA", "dark": "#2C2C2E" },
    "systemGray6":  { "light": "#F2F2F7", "dark": "#1C1C1E" }
  },
  "semantic": {
    "background":          { "light": "#F2F2F7", "dark": "#000000", "swiftui": "Color(.systemGroupedBackground)" },
    "surface":             { "light": "#FFFFFF", "dark": "#1C1C1E", "swiftui": "Color(.secondarySystemGroupedBackground)" },
    "surfaceRaised":       { "light": "#FFFFFF", "dark": "#2C2C2E", "swiftui": "Color(.tertiarySystemGroupedBackground)" },
    "label":               { "light": "#000000", "dark": "#FFFFFF", "swiftui": ".primary" },
    "labelSecondary":      { "light": "rgba(60,60,67,0.60)", "dark": "rgba(235,235,245,0.60)", "swiftui": ".secondary" },
    "labelTertiary":       { "light": "rgba(60,60,67,0.30)", "dark": "rgba(235,235,245,0.30)", "swiftui": ".tertiary" },
    "separator":           { "light": "rgba(60,60,67,0.29)", "dark": "rgba(84,84,88,0.60)", "swiftui": "Color(.separator)" },
    "fill":                { "light": "rgba(120,120,128,0.20)", "dark": "rgba(120,120,128,0.36)", "swiftui": "Color(.systemFill)" },
    "fillSecondary":       { "light": "rgba(120,120,128,0.16)", "dark": "rgba(120,120,128,0.32)", "swiftui": "Color(.secondarySystemFill)" }
  },
  "blink": {
    "accent":         { "maps": "systemBlue", "swiftui": "Color.accentColor", "note": "On macOS follows the user's chosen accent colour" },
    "mood.rest":      { "value": "#FFFFFF", "note": "Eye colour at rest" },
    "mood.headsUp":   { "maps": "systemMint", "note": "Time: meetings, reminders, countdowns" },
    "mood.important": { "maps": "systemRed", "note": "Needs you: important mail, limits" },
    "mood.thinking":  { "maps": "systemIndigo", "note": "Claude is working" },
    "mood.done":      { "maps": "systemGreen", "note": "Done, approved, on track" },
    "mood.attention": { "maps": "systemOrange", "note": "Concerned, evening, sleepy" },
    "money.food":     { "maps": "systemPink" },
    "money.work":     { "maps": "systemPurple" },
    "money.transport":{ "maps": "systemCyan" },
    "money.home":     { "maps": "systemBrown" },
    "notch.hardware": { "value": "#000000", "note": "Always pure black, both appearances" },
    "notch.tile":     { "top": "#2C2C2E", "bottom": "#1C1C1E" },
    "mascot.shell":   { "stops": ["#FFFFFF", "#F2F2F7", "#D1D1D6", "#AEAEB2"], "note": "Porcelain: built from Apple's grays" },
    "mascot.patch":   { "stops": ["#48484A", "#1C1C1E", "#000000"], "note": "Ink glass" }
  },
  "glow": { "alpha": 0.55, "blurPt": 10, "rule": "Inside the notch or a live element only; never on static content" },
  "materials": {
    "liquidGlass.regular": { "swiftui": ".glassEffect(.regular)", "use": "Toolbars, tab bar, sidebar, floating buttons" },
    "liquidGlass.clear":   { "swiftui": ".glassEffect(.clear)", "use": "Over photos and the mascot stage only" },
    "liquidGlass.tinted":  { "swiftui": ".glassEffect(.regular.tint(.accentColor))", "use": "One primary floating control per screen" },
    "ultraThin":           { "swiftui": ".ultraThinMaterial", "use": "Hover peeks over busy wallpapers" },
    "thin":                { "swiftui": ".thinMaterial", "use": "Popovers, notch peek on non-notch Macs" },
    "regular":             { "swiftui": ".regularMaterial", "use": "Sheets, Ask-First cards on iPhone" },
    "thick":               { "swiftui": ".thickMaterial", "use": "Text-heavy overlays" },
    "reduceTransparency":  { "rule": "Every material falls back to `surface` automatically" }
  },
  "shape": {
    "corners": "continuous (squircle) everywhere",
    "radius": { "notchRest": 12, "notchOpen": 28, "card": 22, "tile": 18, "button": "capsule", "chip": "capsule" },
    "concentric": "innerRadius = outerRadius - padding",
    "hairline": "1 px at the display scale (0.5 pt on Retina)"
  },
  "elevation": {
    "light": { "card": ["0 1 2 rgba(0,0,0,0.06)", "0 8 24 rgba(0,0,0,0.08)"] },
    "dark":  { "card": "no shadow; use surfaceRaised + top specular edge rgba(255,255,255,0.10)" },
    "specularEdge": { "light": "inset 0 1 0 rgba(255,255,255,0.70)", "dark": "inset 0 1 0 rgba(255,255,255,0.10)" }
  },
  "type": {
    "ui": "SF Pro (system)",
    "numbers": "SF Pro Rounded, semibold, tabular figures",
    "code": "SF Mono"
  }
}
